# Ignore ALL dotfiles/dotdirs (starting with .)
.*
# Except .gitignore and .git/
!.gitignore
!.git/
ActionGenome
ollama/ollama_models
ollama/logs
star_code/data/datasets
star_code/logs
star_code/outputs
star_code/models
star_code/experiments/video_dump
star_code/notebooks/outputs
star_code/.env
star_code/webapp
star_code/scripts/data
star_code/scripts/output
star_code/src/misc/Video-ChatGPT
star_code/src/misc/video_chatgpt
nltk_data

# ignore python temporary and compiled files
**/__pycache__/
*.py[cod]
*$py.class

# ignore private.env files - may contain sensible data
*private.env
